<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>HannaUIDemo</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Hanna Lab</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.hannamaui.hannalab</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Default RIDs so restore/design-time and CLI builds match Apple Silicon (avoids NETSDK1047 for missing iossimulator-arm64 / maccatalyst-arm64). Override when deploying: -r ios-arm64 -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">ios-arm64</RuntimeIdentifier>
	</PropertyGroup>

		<!-- Android -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">maccatalyst-arm64</RuntimeIdentifier>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0EA5C6" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0EA5C6" BaseSize="128,128" />

		<!-- Images (only referenced assets; unused template folders removed) -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Include="Resources\Images\probe_conditions\probe_conditioning_*p.png"
		           Exclude="Resources\Images\probe_conditions\*@*"
		           Resize="True"
		           BaseSize="18,22" />
		<MauiImage Update="Resources\Images\tab_halo.png" Resize="True" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\tab_photometer.png" Resize="True" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\tab_multimeter.png" Resize="True" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\tab_logs.svg" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\tab_info.svg" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\tab_help.svg" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\tab_profile.svg" BaseSize="24,24" />
		<MauiImage Update="Resources\Images\bluetooth_icon.svg" BaseSize="24,24" />
		<MauiImage Update="Resources\Images\hanna_instruments_logo.png" Resize="True" BaseSize="280,72" />
		<!-- Canonical product-shot icons used across the app for the three instrument families. -->
		<MauiImage Update="Resources\Images\photometer_hi97115.png" Resize="True" BaseSize="120,120" />
		<MauiImage Update="Resources\Images\hi98494_multimeter_icon.png" Resize="True" BaseSize="120,120" />
		<MauiImage Update="Resources\Images\halo2_device_icon.png" Resize="True" BaseSize="120,120" />
		<MauiImage Update="Resources\Images\hi98594_new.png" Resize="True" BaseSize="120,120" />
		<MauiImage Update="Resources\Images\halo2_beaker_blue.png" Resize="True" BaseSize="54,42" />
		<MauiImage Update="Resources\Images\halo2_beaker_grey.png" Resize="True" BaseSize="54,42" />
		<!-- Cloud-sync status icons used on log-history rows (one per log session / tank group). -->
		<MauiImage Update="Resources\Images\sync_gray.png" Resize="True" BaseSize="22,22" />
		<MauiImage Update="Resources\Images\sync_green.png" Resize="True" BaseSize="22,22" />
		<MauiImage Update="Resources\Images\home_icon.svg" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\device_list_icon.svg" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\measure_icon.svg" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\log_history.svg" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\help_icon.svg" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\app_settings_icon.svg" BaseSize="28,28" />
		<!-- Landing page icons (Home dashboard hero, How-It-Works workflow, Supported Devices, footer). -->
		<MauiImage Update="Resources\Images\cloud_save_icon.svg" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\export_pdf_icon.svg" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\shield_check_icon.svg" BaseSize="28,28" />
		<MauiImage Update="Resources\Images\chevron_right_icon.svg" BaseSize="24,24" />
		<MauiImage Update="Resources\Images\arrow_right_icon.svg" BaseSize="24,24" />
		<MauiImage Update="Resources\Images\signal_dot_icon.svg" BaseSize="24,24" />
		<MauiImage Update="Resources\Images\chart_bar_icon.svg" BaseSize="24,24" />
		<MauiImage Update="Resources\Images\plus_icon.svg" BaseSize="24,24" />
		<MauiImage Update="Resources\Images\bluetooth_icon_white.svg" BaseSize="24,24" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

</Project>
