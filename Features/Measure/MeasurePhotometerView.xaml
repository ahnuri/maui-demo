<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HannaUIDemo.Features.Measure.MeasurePhotometerView"
             BackgroundColor="{DynamicResource AppBackground}">
    <Grid RowDefinitions="*, Auto">
        <ScrollView x:Name="BodyScroll" Grid.Row="0">
            <VerticalStackLayout x:Name="BodyStack" Padding="16,8,16,16" Spacing="0" />
        </ScrollView>
        <VerticalStackLayout x:Name="FooterHost" Grid.Row="1" Padding="16,0,16,24" IsVisible="False" />
    </Grid>
</ContentView>
