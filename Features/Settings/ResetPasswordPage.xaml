<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HannaUIDemo.Features.Settings.ResetPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:settings="clr-namespace:HannaUIDemo.Features.Settings"
    xmlns:views="clr-namespace:HannaUIDemo.Features.Settings.Views"
    x:DataType="settings:ResetPasswordViewModel"
    Title="{Binding PageTitle}"
    BackgroundColor="{DynamicResource StoreGroupedBackground}"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarHasShadow="False">

    <ScrollView Padding="20,8,20,32">
        <VerticalStackLayout Spacing="16">
            <views:HannaBrandHeader LogoHeight="40" Title="HANNA CLOUD" />

            <Border Padding="14,12" BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Divider}" StrokeThickness="0.5">
                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                <Entry IsPassword="{Binding ShowOldPassword, Converter={StaticResource InvertedBoolConverter}}" Placeholder="{Binding OldPasswordPlaceholder}" Text="{Binding OldPassword}" TextColor="{DynamicResource OnSurface}" />
            </Border>
            <Border Padding="14,12" BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Divider}" StrokeThickness="0.5">
                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                <Entry IsPassword="{Binding ShowNewPassword, Converter={StaticResource InvertedBoolConverter}}" Placeholder="{Binding NewPasswordPlaceholder}" Text="{Binding NewPassword}" TextColor="{DynamicResource OnSurface}" />
            </Border>
            <Label FontSize="12" LineBreakMode="WordWrap" Text="{Binding PasswordRules}" TextColor="{DynamicResource OnSurfaceVariant}" />
            <Border Padding="14,12" BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Divider}" StrokeThickness="0.5">
                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                <Entry IsPassword="{Binding ShowConfirmPassword, Converter={StaticResource InvertedBoolConverter}}" Placeholder="{Binding ConfirmPasswordPlaceholder}" Text="{Binding ConfirmPassword}" TextColor="{DynamicResource OnSurface}" />
            </Border>
            <Button BackgroundColor="{StaticResource Primary}" Command="{Binding ResetCommand}" CornerRadius="12" FontAttributes="Bold" FontSize="16" HeightRequest="50" Margin="0,8,0,0" Text="{Binding ResetButtonText}" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
