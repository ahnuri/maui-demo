<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HannaUIDemo.Features.Settings.HannaCloudHubPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:settings="clr-namespace:HannaUIDemo.Features.Settings"
    xmlns:views="clr-namespace:HannaUIDemo.Features.Settings.Views"
    x:DataType="settings:HannaCloudHubViewModel"
    Title="{Binding PageTitle}"
    BackgroundColor="{DynamicResource StoreGroupedBackground}"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarHasShadow="False">

    <ContentPage.Resources>
        <Style x:Key="ActionTitleStyle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="ActionIconStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySubtleFill}" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="WidthRequest" Value="40" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="12" />
            </Setter>
        </Style>
        <Style x:Key="ActionCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Stroke" Value="{DynamicResource Divider}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="16" />
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ScrollView Padding="20,12,20,32">
        <VerticalStackLayout Spacing="20">
            <views:HannaBrandHeader LogoHeight="40" />

            <Border
                Padding="16"
                BackgroundColor="{DynamicResource Surface}"
                Stroke="{DynamicResource Divider}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Label
                    FontSize="14"
                    LineBreakMode="WordWrap"
                    Text="{Binding HubIntro}"
                    TextColor="{DynamicResource OnSurfaceVariant}" />
            </Border>

            <Border Style="{StaticResource ActionCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Style="{StaticResource ActionIconStyle}">
                            <Label FontSize="19" HorizontalOptions="Center" Text="&#x2699;" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Style="{StaticResource ActionTitleStyle}" Text="{Binding CloudSettingsText}" />
                        <Label Grid.Column="2" FontSize="22" Text="&#x203A;" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCloudSettingsCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <BoxView Margin="68,0,0,0" HeightRequest="1" Color="{DynamicResource Divider}" />

                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Style="{StaticResource ActionIconStyle}">
                            <Image
                                Aspect="AspectFit"
                                HeightRequest="21"
                                HorizontalOptions="Center"
                                Source="tab_profile"
                                VerticalOptions="Center"
                                WidthRequest="21" />
                        </Border>
                        <Label Grid.Column="1" Style="{StaticResource ActionTitleStyle}" Text="{Binding ProfileInformationText}" />
                        <Label Grid.Column="2" FontSize="22" Text="&#x203A;" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <BoxView Margin="68,0,0,0" HeightRequest="1" Color="{DynamicResource Divider}" />

                    <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Style="{StaticResource ActionIconStyle}">
                            <Label FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" Text="*" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Style="{StaticResource ActionTitleStyle}" Text="{Binding ResetPasswordText}" />
                        <Label Grid.Column="2" FontSize="22" Text="&#x203A;" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenResetPasswordCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource ActionCardStyle}">
                <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border
                        BackgroundColor="{DynamicResource SurfaceSecondary}"
                        HeightRequest="40"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label FontSize="18" HorizontalOptions="Center" Text="&#x23CE;" TextColor="#EF4444" VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1" Style="{StaticResource ActionTitleStyle}" Text="{Binding LogOutText}" TextColor="#EF4444" />
                    <Label Grid.Column="2" FontSize="22" Text="&#x203A;" TextColor="#EF4444" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogOutCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
