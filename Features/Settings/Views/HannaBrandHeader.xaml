<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="HannaUIDemo.Features.Settings.Views.HannaBrandHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root"
    HorizontalOptions="Center">

    <VerticalStackLayout
        x:Name="HeaderStack"
        HorizontalOptions="Center"
        Spacing="10">
        <Image
            x:Name="LogoImage"
            Aspect="AspectFit"
            HeightRequest="44"
            HorizontalOptions="Center"
            SemanticProperties.Description="Hanna Instruments logo"
            Source="hanna_instruments_logo.png" />
        <Label
            x:Name="TitleLabel"
            CharacterSpacing="1.5"
            FontAttributes="Bold"
            FontSize="17"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            IsVisible="False"
            TextColor="{StaticResource Primary}" />
        <Label
            x:Name="SubtitleLabel"
            FontSize="13"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            IsVisible="False"
            LineBreakMode="WordWrap"
            TextColor="{DynamicResource OnSurfaceVariant}" />
    </VerticalStackLayout>
</ContentView>
