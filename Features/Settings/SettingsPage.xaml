<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:settings="clr-namespace:HannaUIDemo.Features.Settings"
             x:Class="HannaUIDemo.Features.Settings.SettingsPage"
             x:DataType="settings:SettingsViewModel"
             Title="Settings"
             BackgroundColor="{DynamicResource PageBackground}">
    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="8">
            <Label
                Margin="0,0,0,4"
                FontAttributes="Bold"
                FontSize="14"
                Text="Device Settings"
                TextColor="{DynamicResource OnSurfaceVariant}" />
            <Border
                BackgroundColor="{DynamicResource Surface}"
                Padding="0"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Offset="0,4" Opacity="0.12" Radius="12" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label FontSize="22" Text="&#x2697;" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Chemical Form" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text=">" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenChemicalFormCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="16,0" />
                    <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label FontSize="22" Text="&#x2697;" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label FontAttributes="Bold" Text="Sync Readings" />
                            <Label FontSize="12" LineBreakMode="WordWrap" Text="Download readings from Photometer to Hanna Lab App" TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" FontSize="22" Text="&#x21BB;" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SyncReadingsCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="16,0" />
                    <Grid Padding="16,12,16,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label FontSize="18" Text="&#x2600;" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Backlight" VerticalOptions="Center" />
                        <Border Grid.Column="2" Padding="8,2" BackgroundColor="{DynamicResource SurfaceSecondary}" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Label Text="{Binding BacklightPercent}" FontSize="12" />
                        </Border>
                    </Grid>
                    <Slider Margin="16,0" Maximum="100" Minimum="0" Value="{Binding Backlight}" />
                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="16,0" />
                    <Grid Padding="16,12,16,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label FontSize="18" Text="&#x25D0;" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Contrast" VerticalOptions="Center" />
                        <Border Grid.Column="2" Padding="8,2" BackgroundColor="{DynamicResource SurfaceSecondary}" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Label Text="{Binding ContrastPercent}" FontSize="12" />
                        </Border>
                    </Grid>
                    <Slider Margin="16,0,16,8" Maximum="100" Minimum="0" Value="{Binding Contrast}" />
                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="16,0" />
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Separator" VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="0">
                            <Button
                                BackgroundColor="{Binding DotSeparatorBackground}"
                                Command="{Binding SelectDotSeparatorCommand}"
                                CornerRadius="0"
                                FontSize="12"
                                Padding="12,6"
                                Text="Dot"
                                TextColor="{Binding DotSeparatorTextColor}" />
                            <Button
                                BackgroundColor="{Binding CommaSeparatorBackground}"
                                Command="{Binding SelectCommaSeparatorCommand}"
                                CornerRadius="0"
                                FontSize="12"
                                Padding="12,6"
                                Text="Comma"
                                TextColor="{Binding CommaSeparatorTextColor}" />
                        </HorizontalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="16,0" />
                    <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label FontSize="22" Text="&#x263A;" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Language" VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                            <Label Text="{Binding LanguageDisplay}" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center" />
                            <Label Text=">" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenLanguageCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="16,0" />
                    <Grid Padding="8,4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Padding="8,0" FontSize="22" Text="&#x266A;" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Beep" VerticalOptions="Center" />
                        <Switch Grid.Column="2" IsToggled="{Binding Beep}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" Margin="16,0" />
                    <Grid Padding="8,4,8,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Padding="8,0" FontSize="22" Text="&#x266B;" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Tutorial" VerticalOptions="Center" />
                        <Switch Grid.Column="2" IsToggled="{Binding Tutorial}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
