<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="HannaUIDemo.Features.Home.HomeView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:home="clr-namespace:HannaUIDemo.Features.Home"
    x:DataType="home:HomeViewModel"
    BackgroundColor="{DynamicResource PageBackground}">

    <!--
        Landing page (Hanna Lab home).
        Sections (top → bottom):
          1. Hero card  – brand badge, title, subtitle, device portraits, two
             stat tiles, primary "Connect Device" CTA.
          2. How It Works – horizontal 4-step workflow inside one card.
          3. Supported Hanna Devices – horizontal chip list + "More" pill.
          4. Trust footer – "Secure. Reliable. Connected." banner.

        Visual tokens: every color, font, spacing, radius, and icon size comes
        from global Colors.xaml / Tokens.xaml / SemanticResources. All copy is
        bound to HomeViewModel which resolves through TranslationStore.
    -->

    <ContentView.Resources>

        <!--  Generic white surface card used by all sections below the hero.  -->
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource SpacingLg}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
            <Setter Property="Stroke" Value="{DynamicResource Divider}" />
            <Setter Property="StrokeThickness" Value="{StaticResource StrokeHairline}" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="{StaticResource RadiusXxxl}" />
            </Setter>
        </Style>

        <!--  Translucent tile inside the hero card (stat counters).  -->
        <Style x:Key="LabTileStyle" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource SpacingMdPlus}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource LabHeroTileBackground}" />
            <Setter Property="Stroke" Value="{DynamicResource LabHeroTileStroke}" />
            <Setter Property="StrokeThickness" Value="{StaticResource StrokeThin}" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="{StaticResource RadiusXxl}" />
            </Setter>
        </Style>

        <!--  Section heading ("How It Works", "Supported Hanna Devices").  -->
        <Style x:Key="SectionLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSubheadLarge}" />
            <Setter Property="TextColor" Value="{DynamicResource OnSurface}" />
        </Style>

        <!--  Workflow step icon container (rounded square card).  -->
        <Style x:Key="StepIconBoxStyle" TargetType="Border">
            <Setter Property="HeightRequest" Value="{StaticResource IconSizeHero}" />
            <Setter Property="WidthRequest" Value="{StaticResource IconSizeHero}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource FlyoutIconBadge}" />
            <Setter Property="Stroke" Value="{DynamicResource Divider}" />
            <Setter Property="StrokeThickness" Value="{StaticResource StrokeHairline}" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="{StaticResource RadiusLg}" />
            </Setter>
        </Style>

        <!--  Numbered circle badge that sits above each workflow icon.  -->
        <Style x:Key="StepNumberBadgeStyle" TargetType="Border">
            <Setter Property="HeightRequest" Value="20" />
            <Setter Property="WidthRequest" Value="20" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="10" />
            </Setter>
        </Style>

        <!--  Supported-device chip (icon + label, pill border).  -->
        <Style x:Key="DeviceChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource SpacingSmPlus}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
            <Setter Property="Stroke" Value="{DynamicResource Divider}" />
            <Setter Property="StrokeThickness" Value="{StaticResource StrokeThin}" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="{StaticResource RadiusPill}" />
            </Setter>
        </Style>

        <!--  Secondary CTA pill: "+ More Supported Instruments".  -->
        <Style x:Key="GhostPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource SpacingMd}" />
            <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySubtleBanner}" />
            <Setter Property="Stroke" Value="{DynamicResource PrimarySubtleStroke}" />
            <Setter Property="StrokeThickness" Value="{StaticResource StrokeThin}" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="{StaticResource RadiusPill}" />
            </Setter>
        </Style>

    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,28" Spacing="{StaticResource SpacingLg}">

            <!--  ════════ 1) HERO CARD ════════  -->
            <Border StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource RadiusHero}" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource LabHeroGradientStart}" Offset="0.0" />
                        <GradientStop Color="{DynamicResource LabHeroGradientMid}" Offset="0.62" />
                        <GradientStop Color="{DynamicResource LabHeroGradientEnd}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Opacity="0.20" Radius="22" Offset="0,8" />
                </Border.Shadow>

                <Grid Padding="20,22" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource SpacingLg}">

                    <!--  Row 0 — Badge, title, subtitle (left) + device portraits (right)  -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingMdPlus}">
                        <VerticalStackLayout Spacing="{StaticResource SpacingSm}">

                            <!--  Status badge (green dot + brand line)  -->
                            <Border
                                Padding="10,4"
                                BackgroundColor="{DynamicResource LabHeroBadgeFill}"
                                HorizontalOptions="Start"
                                Stroke="{DynamicResource LabHeroBadgeStroke}"
                                StrokeThickness="{StaticResource StrokeThin}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{StaticResource RadiusXl}" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="{StaticResource SpacingXxs}">
                                    <Border
                                        BackgroundColor="{StaticResource Success}"
                                        HeightRequest="8"
                                        StrokeThickness="0"
                                        VerticalOptions="Center"
                                        WidthRequest="8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="4" />
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label
                                        FontFamily="{StaticResource FontFamilySemibold}"
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        CharacterSpacing="1"
                                        Text="{Binding HeroBadge}"
                                        TextColor="{DynamicResource LabHeroText}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Label
                                FontFamily="{StaticResource FontFamilySemibold}"
                                FontAttributes="Bold"
                                FontSize="{StaticResource FontSizeDisplay}"
                                LineBreakMode="WordWrap"
                                Text="{Binding HeroTitle}"
                                TextColor="{DynamicResource LabHeroText}" />
                            <Label
                                FontSize="{StaticResource FontSizeBody}"
                                LineBreakMode="WordWrap"
                                Text="{Binding HeroSubtitle}"
                                TextColor="{DynamicResource LabHeroMuted}" />
                        </VerticalStackLayout>

                        <!--  Floating device portraits (overlapping stack)  -->
                        <Grid
                            Grid.Column="1"
                            HeightRequest="104"
                            VerticalOptions="Start"
                            WidthRequest="108">
                            <Border
                                Margin="24,0,0,8"
                                Padding="{StaticResource SpacingXs}"
                                BackgroundColor="{DynamicResource LabHeroDeviceFrame}"
                                HeightRequest="74"
                                Stroke="{DynamicResource LabHeroDeviceStroke}"
                                StrokeThickness="{StaticResource StrokeThin}"
                                VerticalOptions="Start"
                                WidthRequest="74">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{StaticResource RadiusXl}" />
                                </Border.StrokeShape>
                                <Image Aspect="AspectFit" Source="photometer_hi97115.png" />
                            </Border>
                            <Border
                                Margin="0,44,42,0"
                                Padding="{StaticResource SpacingXs}"
                                BackgroundColor="{DynamicResource LabHeroDeviceFrame}"
                                HeightRequest="54"
                                Stroke="{DynamicResource LabHeroDeviceStroke}"
                                StrokeThickness="{StaticResource StrokeThin}"
                                VerticalOptions="Start"
                                WidthRequest="54">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{StaticResource RadiusXxl}" />
                                </Border.StrokeShape>
                                <Image Aspect="AspectFit" Source="halo2_device_icon.png" />
                            </Border>
                            <Border
                                Margin="60,52,0,0"
                                Padding="{StaticResource SpacingXs}"
                                BackgroundColor="{DynamicResource LabHeroDeviceFrame}"
                                HeightRequest="46"
                                Stroke="{DynamicResource LabHeroDeviceStroke}"
                                StrokeThickness="{StaticResource StrokeThin}"
                                VerticalOptions="Start"
                                WidthRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{StaticResource RadiusLg}" />
                                </Border.StrokeShape>
                                <Image Aspect="AspectFit" Source="hi98494_multimeter_icon.png" />
                            </Border>
                        </Grid>
                    </Grid>

                    <!--  Row 1 — Stat tiles (Connected devices + Today's records)  -->
                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="{StaticResource SpacingSmPlus}">

                        <Border Style="{StaticResource LabTileStyle}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingSm}">
                                <Border
                                    HeightRequest="{StaticResource IconButtonSm}"
                                    WidthRequest="{StaticResource IconButtonSm}"
                                    BackgroundColor="{DynamicResource FlyoutIconBadge}"
                                    Stroke="{DynamicResource Divider}"
                                    StrokeThickness="{StaticResource StrokeHairline}"
                                    VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="{StaticResource IconSizeSm}"
                                        Source="signal_dot_icon"
                                        WidthRequest="{StaticResource IconSizeSm}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource SpacingXs}">
                                    <Label
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Text="{Binding ConnectedLabel}"
                                        TextColor="{DynamicResource LabHeroMuted}" />
                                    <Label
                                        FontFamily="{StaticResource FontFamilySemibold}"
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizeDisplay}"
                                        Text="{Binding ConnectedDevicesCount}"
                                        TextColor="{DynamicResource LabHeroText}" />
                                    <Label
                                        FontSize="{StaticResource FontSizeCaption}"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding ConnectedSub}"
                                        TextColor="{DynamicResource LabHeroMuted}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource LabTileStyle}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingSm}">
                                <Border
                                    HeightRequest="{StaticResource IconButtonSm}"
                                    WidthRequest="{StaticResource IconButtonSm}"
                                    BackgroundColor="{DynamicResource SubtleGreen}"
                                    Stroke="{DynamicResource Divider}"
                                    StrokeThickness="{StaticResource StrokeHairline}"
                                    VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="{StaticResource IconSizeSm}"
                                        Source="chart_bar_icon"
                                        WidthRequest="{StaticResource IconSizeSm}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource SpacingXs}">
                                    <Label
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Text="{Binding RecordsTodayLabel}"
                                        TextColor="{DynamicResource LabHeroMuted}" />
                                    <Label
                                        FontFamily="{StaticResource FontFamilySemibold}"
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizeDisplay}"
                                        Text="{Binding TodayLogsCount}"
                                        TextColor="{DynamicResource LabHeroText}" />
                                    <Label
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Text="{Binding RecordsTodaySub}"
                                        TextColor="{DynamicResource LabHeroMuted}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>

                    <!--
                        Row 2 — Primary CTA. Implemented as a Border (not Button) so we
                        can stack a bluetooth glyph + header + subtitle inside the pill.
                    -->
                    <Border
                        Grid.Row="2"
                        BackgroundColor="{StaticResource Primary}"
                        Padding="{StaticResource SpacingMd}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource RadiusPill}" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ScanDevicesCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingSmPlus}" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image
                                Aspect="AspectFit"
                                HeightRequest="{StaticResource IconSizeMdPlus}"
                                Source="bluetooth_icon_white"
                                VerticalOptions="Center"
                                WidthRequest="{StaticResource IconSizeMdPlus}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label
                                    FontFamily="{StaticResource FontFamilySemibold}"
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeSubheadLarge}"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding ScanInstrumentsLabel}"
                                    TextColor="{StaticResource White}" />
                                <Label
                                    FontSize="{StaticResource FontSizeSmall}"
                                    HorizontalTextAlignment="Center"
                                    Opacity="0.9"
                                    Text="{Binding ScanInstrumentsSub}"
                                    TextColor="{StaticResource White}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  ════════ 2) HOW IT WORKS — 4-step horizontal workflow ════════  -->
            <VerticalStackLayout Spacing="{StaticResource SpacingSmPlus}">
                <Label Style="{StaticResource SectionLabelStyle}" Text="{Binding WorkflowSection}" />

                <Border Style="{StaticResource DashboardCardStyle}" Padding="{StaticResource SpacingMd}">
                    <Grid
                        ColumnDefinitions="*,Auto,*,Auto,*,Auto,*"
                        ColumnSpacing="{StaticResource SpacingXs}"
                        VerticalOptions="Start">

                        <!--  Step 1 — Connect  -->
                        <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource SpacingXs}">
                            <Border Style="{StaticResource StepNumberBadgeStyle}" BackgroundColor="{StaticResource Primary}">
                                <Label
                                    FontFamily="{StaticResource FontFamilySemibold}"
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    HorizontalOptions="Center"
                                    Text="1"
                                    TextColor="{StaticResource White}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Border Style="{StaticResource StepIconBoxStyle}">
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="{StaticResource IconSizeMd}"
                                    Source="bluetooth_icon"
                                    WidthRequest="{StaticResource IconSizeMd}" />
                            </Border>
                            <Label
                                FontFamily="{StaticResource FontFamilySemibold}"
                                FontAttributes="Bold"
                                FontSize="{StaticResource FontSizeBody}"
                                HorizontalTextAlignment="Center"
                                Text="{Binding WorkflowConnect}"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="{StaticResource FontSizeCaption}"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Text="{Binding WorkflowConnectSub}"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>

                        <Image
                            Grid.Column="1"
                            Aspect="AspectFit"
                            HeightRequest="{StaticResource IconSizeSm}"
                            Source="arrow_right_icon"
                            VerticalOptions="Center"
                            WidthRequest="{StaticResource IconSizeSm}" />

                        <!--  Step 2 — Measure & Tag  -->
                        <VerticalStackLayout Grid.Column="2" Spacing="{StaticResource SpacingXs}">
                            <Border Style="{StaticResource StepNumberBadgeStyle}" BackgroundColor="{DynamicResource LabWarning}">
                                <Label
                                    FontFamily="{StaticResource FontFamilySemibold}"
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    HorizontalOptions="Center"
                                    Text="2"
                                    TextColor="{StaticResource White}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Border Style="{StaticResource StepIconBoxStyle}">
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="{StaticResource IconSizeMd}"
                                    Source="measure_icon"
                                    WidthRequest="{StaticResource IconSizeMd}" />
                            </Border>
                            <Label
                                FontFamily="{StaticResource FontFamilySemibold}"
                                FontAttributes="Bold"
                                FontSize="{StaticResource FontSizeBody}"
                                HorizontalTextAlignment="Center"
                                Text="{Binding WorkflowMeasure}"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="{StaticResource FontSizeCaption}"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Text="{Binding WorkflowMeasureSub}"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>

                        <Image
                            Grid.Column="3"
                            Aspect="AspectFit"
                            HeightRequest="{StaticResource IconSizeSm}"
                            Source="arrow_right_icon"
                            VerticalOptions="Center"
                            WidthRequest="{StaticResource IconSizeSm}" />

                        <!--  Step 3 — Save Logs  -->
                        <VerticalStackLayout Grid.Column="4" Spacing="{StaticResource SpacingXs}">
                            <Border Style="{StaticResource StepNumberBadgeStyle}" BackgroundColor="{StaticResource Success}">
                                <Label
                                    FontFamily="{StaticResource FontFamilySemibold}"
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    HorizontalOptions="Center"
                                    Text="3"
                                    TextColor="{StaticResource White}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Border Style="{StaticResource StepIconBoxStyle}">
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="{StaticResource IconSizeMd}"
                                    Source="cloud_save_icon"
                                    WidthRequest="{StaticResource IconSizeMd}" />
                            </Border>
                            <Label
                                FontFamily="{StaticResource FontFamilySemibold}"
                                FontAttributes="Bold"
                                FontSize="{StaticResource FontSizeBody}"
                                HorizontalTextAlignment="Center"
                                Text="{Binding WorkflowStore}"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="{StaticResource FontSizeCaption}"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Text="{Binding WorkflowStoreSub}"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>

                        <Image
                            Grid.Column="5"
                            Aspect="AspectFit"
                            HeightRequest="{StaticResource IconSizeSm}"
                            Source="arrow_right_icon"
                            VerticalOptions="Center"
                            WidthRequest="{StaticResource IconSizeSm}" />

                        <!--  Step 4 — Export & Share  -->
                        <VerticalStackLayout Grid.Column="6" Spacing="{StaticResource SpacingXs}">
                            <Border Style="{StaticResource StepNumberBadgeStyle}" BackgroundColor="{StaticResource Primary}">
                                <Label
                                    FontFamily="{StaticResource FontFamilySemibold}"
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    HorizontalOptions="Center"
                                    Text="4"
                                    TextColor="{StaticResource White}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Border Style="{StaticResource StepIconBoxStyle}">
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="{StaticResource IconSizeMd}"
                                    Source="export_pdf_icon"
                                    WidthRequest="{StaticResource IconSizeMd}" />
                            </Border>
                            <Label
                                FontFamily="{StaticResource FontFamilySemibold}"
                                FontAttributes="Bold"
                                FontSize="{StaticResource FontSizeBody}"
                                HorizontalTextAlignment="Center"
                                Text="{Binding WorkflowReview}"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="{StaticResource FontSizeCaption}"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Text="{Binding WorkflowReviewSub}"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!--  ════════ 3) SUPPORTED HANNA DEVICES ════════  -->
            <VerticalStackLayout Spacing="{StaticResource SpacingSmPlus}">

                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Style="{StaticResource SectionLabelStyle}" Text="{Binding SupportedFamiliesLabel}" />
                    <Label
                        Grid.Column="1"
                        FontFamily="{StaticResource FontFamilySemibold}"
                        FontAttributes="Bold"
                        FontSize="{StaticResource FontSizeBody}"
                        Text="{Binding ViewAllLabel}"
                        TextColor="{DynamicResource LinkBlue}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenDevicesCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <ScrollView
                    HorizontalScrollBarVisibility="Never"
                    Orientation="Horizontal">
                    <HorizontalStackLayout Spacing="{StaticResource SpacingSm}">

                        <!--
                            Each chip pairs a real device photo with its family label.
                            Mapping (per product brief):
                              • HALO2 pH Tester       → halo2_device_icon.png
                              • Marine Master         → photometer_hi97115.png
                              • Photometer            → photometer_hi97115.png
                              • Multiparameter        → hi98494_multimeter_icon.png
                              • HI98x94 Meter         → hi98494_multimeter_icon.png
                        -->
                        <Border Style="{StaticResource DeviceChipStyle}">
                            <HorizontalStackLayout Spacing="{StaticResource SpacingXs}" VerticalOptions="Center">
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="{StaticResource IconSizeLg}"
                                    Source="halo2_device_icon.png"
                                    VerticalOptions="Center"
                                    WidthRequest="{StaticResource IconSizeLg}" />
                                <Label
                                    FontFamily="{StaticResource FontFamilySemibold}"
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding ChipHalo}"
                                    TextColor="{DynamicResource OnSurface}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Style="{StaticResource DeviceChipStyle}">
                            <HorizontalStackLayout Spacing="{StaticResource SpacingXs}" VerticalOptions="Center">
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="{StaticResource IconSizeLg}"
                                    Source="photometer_hi97115.png"
                                    VerticalOptions="Center"
                                    WidthRequest="{StaticResource IconSizeLg}" />
                                <Label
                                    FontFamily="{StaticResource FontFamilySemibold}"
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding ChipMarineMaster}"
                                    TextColor="{DynamicResource OnSurface}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Style="{StaticResource DeviceChipStyle}">
                            <HorizontalStackLayout Spacing="{StaticResource SpacingXs}" VerticalOptions="Center">
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="{StaticResource IconSizeLg}"
                                    Source="photometer_hi97115.png"
                                    VerticalOptions="Center"
                                    WidthRequest="{StaticResource IconSizeLg}" />
                                <Label
                                    FontFamily="{StaticResource FontFamilySemibold}"
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding ChipPhotometer}"
                                    TextColor="{DynamicResource OnSurface}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Style="{StaticResource DeviceChipStyle}">
                            <HorizontalStackLayout Spacing="{StaticResource SpacingXs}" VerticalOptions="Center">
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="{StaticResource IconSizeLg}"
                                    Source="hi98494_multimeter_icon.png"
                                    VerticalOptions="Center"
                                    WidthRequest="{StaticResource IconSizeLg}" />
                                <Label
                                    FontFamily="{StaticResource FontFamilySemibold}"
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding ChipMultiparameter}"
                                    TextColor="{DynamicResource OnSurface}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Style="{StaticResource DeviceChipStyle}">
                            <HorizontalStackLayout Spacing="{StaticResource SpacingXs}" VerticalOptions="Center">
                                <Image
                                    Aspect="AspectFit"
                                    HeightRequest="{StaticResource IconSizeLg}"
                                    Source="hi98494_multimeter_icon.png"
                                    VerticalOptions="Center"
                                    WidthRequest="{StaticResource IconSizeLg}" />
                                <Label
                                    FontFamily="{StaticResource FontFamilySemibold}"
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding ChipMeter}"
                                    TextColor="{DynamicResource OnSurface}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                    </HorizontalStackLayout>
                </ScrollView>

                <Border Style="{StaticResource GhostPillStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenDevicesCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontFamily="{StaticResource FontFamilySemibold}"
                        FontAttributes="Bold"
                        FontSize="{StaticResource FontSizeBody}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding MoreSupportedLabel}"
                        TextColor="{StaticResource Primary}" />
                </Border>
            </VerticalStackLayout>

            <!--  ════════ 4) TRUST FOOTER ════════  -->
            <Border Style="{StaticResource DashboardCardStyle}" Padding="{StaticResource SpacingMdPlus}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingMd}" VerticalOptions="Center">
                    <Border
                        HeightRequest="{StaticResource IconButtonMd}"
                        WidthRequest="{StaticResource IconButtonMd}"
                        BackgroundColor="{DynamicResource FlyoutIconBadge}"
                        Stroke="{DynamicResource Divider}"
                        StrokeThickness="{StaticResource StrokeHairline}"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Image
                            Aspect="AspectFit"
                            HeightRequest="{StaticResource IconSizeMd}"
                            Source="shield_check_icon"
                            WidthRequest="{StaticResource IconSizeMd}" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource SpacingXs}" VerticalOptions="Center">
                        <Label
                            FontFamily="{StaticResource FontFamilySemibold}"
                            FontAttributes="Bold"
                            FontSize="{StaticResource FontSizeBodyLarge}"
                            Text="{Binding TrustTitle}"
                            TextColor="{DynamicResource OnSurface}" />
                        <Label
                            FontSize="{StaticResource FontSizeCaption}"
                            LineBreakMode="WordWrap"
                            Text="{Binding TrustSub}"
                            TextColor="{DynamicResource OnSurfaceVariant}" />
                    </VerticalStackLayout>

                    <Image
                        Grid.Column="2"
                        Aspect="AspectFit"
                        HeightRequest="{StaticResource IconSizeMdPlus}"
                        Source="chevron_right_icon"
                        VerticalOptions="Center"
                        WidthRequest="{StaticResource IconSizeMdPlus}" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
