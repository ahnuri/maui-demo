<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="HannaUIDemo.Features.Home.HomeView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:home="clr-namespace:HannaUIDemo.Features.Home"
    x:DataType="home:HomeViewModel"
    BackgroundColor="{DynamicResource PageBackground}">

    <ContentView.Resources>
        <Color x:Key="AnalysisAmber">#F59E0B</Color>
        <Color x:Key="SignalGreen">#22C55E</Color>

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
            <Setter Property="Stroke" Value="{DynamicResource Divider}" />
            <Setter Property="StrokeThickness" Value="0.5" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="18" />
            </Setter>
        </Style>

        <Style x:Key="LabTileStyle" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="BackgroundColor" Value="{DynamicResource LabHeroTileBackground}" />
            <Setter Property="Stroke" Value="{DynamicResource LabHeroTileStroke}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="16" />
            </Setter>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="Label">
            <Setter Property="CharacterSpacing" Value="1" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
        </Style>

    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,28" Spacing="16">

            <Border StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource LabHeroGradientStart}" Offset="0.0" />
                        <GradientStop Color="{DynamicResource LabHeroGradientMid}" Offset="0.62" />
                        <GradientStop Color="{DynamicResource LabHeroGradientEnd}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Opacity="0.20" Radius="22" Offset="0,8" />
                </Border.Shadow>

                <Grid Padding="20,22" RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="8">
                            <Border
                                Padding="10,5"
                                BackgroundColor="{DynamicResource LabHeroBadgeFill}"
                                HorizontalOptions="Start"
                                Stroke="{DynamicResource LabHeroBadgeStroke}"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="7">
                                    <Border
                                        BackgroundColor="{StaticResource SignalGreen}"
                                        HeightRequest="8"
                                        StrokeThickness="0"
                                        VerticalOptions="Center"
                                        WidthRequest="8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="4" />
                                        </Border.StrokeShape>
                                    </Border>
	                                    <Label
	                                        FontAttributes="Bold"
	                                        FontSize="11"
	                                        Text="MULTI-DEVICE LAB"
	                                        TextColor="{DynamicResource LabHeroText}"
	                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Label
                                FontAttributes="Bold"
                                FontSize="30"
                                LineBreakMode="WordWrap"
	                                Text="Connected laboratory workspace"
	                                TextColor="{DynamicResource LabHeroText}" />
	                            <Label
	                                FontSize="13"
	                                LineBreakMode="WordWrap"
	                                Text="Stream readings, annotate results, store logs, export reports, and sync Hanna instrument data from one clean control surface."
	                                TextColor="{DynamicResource LabHeroMuted}" />
                        </VerticalStackLayout>

                        <Grid
                            Grid.Column="1"
                            HeightRequest="104"
                            VerticalOptions="Start"
                            WidthRequest="108">
                            <Border
                                Margin="24,0,0,8"
                                Padding="5"
                                BackgroundColor="{DynamicResource LabHeroDeviceFrame}"
                                HeightRequest="74"
                                Stroke="{DynamicResource LabHeroDeviceStroke}"
                                StrokeThickness="1"
                                VerticalOptions="Start"
                                WidthRequest="74">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Image
                                    Aspect="AspectFit"
                                    Source="photometer_hi97115.png" />
                            </Border>
                            <Border
                                Margin="0,44,42,0"
                                Padding="5"
                                BackgroundColor="{DynamicResource LabHeroDeviceFrame}"
                                HeightRequest="54"
                                Stroke="{DynamicResource LabHeroDeviceStroke}"
                                StrokeThickness="1"
                                VerticalOptions="Start"
                                WidthRequest="54">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Image
                                    Aspect="AspectFit"
                                    Source="halo2_device_icon.png" />
                            </Border>
                            <Border
                                Margin="60,52,0,0"
                                Padding="4"
                                BackgroundColor="{DynamicResource LabHeroDeviceFrame}"
                                HeightRequest="46"
                                Stroke="{DynamicResource LabHeroDeviceStroke}"
                                StrokeThickness="1"
                                VerticalOptions="Start"
                                WidthRequest="46">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>
                                <Image
                                    Aspect="AspectFit"
                                    Source="hi98594_new.png" />
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">
                        <Border Style="{StaticResource LabTileStyle}">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontSize="11"
                                    Text="Connected"
                                    TextColor="{DynamicResource LabHeroMuted}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="28"
                                    Text="{Binding ConnectedDevicesCount}"
                                    TextColor="{DynamicResource LabHeroText}" />
                                <Label
                                    FontSize="11"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding ConnectedSummary}"
                                    TextColor="{DynamicResource LabHeroMuted}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource LabTileStyle}">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontSize="11"
	                                    Text="Records today"
                                    TextColor="{DynamicResource LabHeroMuted}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="28"
                                    Text="{Binding TodayLogsCount}"
                                    TextColor="{DynamicResource LabHeroText}" />
                                <Label
                                    FontSize="11"
	                                    Text="Auto or manual logs"
                                    TextColor="{DynamicResource LabHeroMuted}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Button
                        Grid.Row="2"
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding ScanDevicesCommand}"
                        CornerRadius="24"
                        FontAttributes="Bold"
                        FontSize="15"
                        HeightRequest="50"
                        Text="Scan Instruments"
                        TextColor="White" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Style="{StaticResource DashboardCardStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DemoModeCommand}" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Border
                            BackgroundColor="{DynamicResource SubtleTeal}"
                            HeightRequest="42"
                            StrokeThickness="0"
                            WidthRequest="42"
                            HorizontalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="&#x2697;"
                                TextColor="{StaticResource Primary}"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Row="1" Spacing="3">
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="Measure"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="12"
                                LineBreakMode="WordWrap"
                                Text="Start live analysis"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ViewLogsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Border
                            BackgroundColor="{DynamicResource SubtleGreen}"
                            HeightRequest="42"
                            StrokeThickness="0"
                            WidthRequest="42"
                            HorizontalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="&#x2630;"
                                TextColor="{StaticResource Success}"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Row="1" Spacing="3">
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="Logs"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="12"
                                LineBreakMode="WordWrap"
                                Text="Review history"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>

            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource SectionLabelStyle}" Text="INSTRUMENT BAY" />
                <Border Style="{StaticResource DashboardCardStyle}" Padding="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Grid HeightRequest="128" WidthRequest="132">
                            <Border
                                Margin="32,0,0,0"
                                Padding="6"
                                BackgroundColor="{DynamicResource SurfaceSecondary}"
                                HeightRequest="82"
                                Stroke="{DynamicResource Divider}"
                                StrokeThickness="0.5"
                                WidthRequest="82">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Image Aspect="AspectFit" Source="photometer_hi97115.png" />
                            </Border>
                            <Border
                                Margin="0,62,64,0"
                                Padding="6"
                                BackgroundColor="{DynamicResource SurfaceSecondary}"
                                HeightRequest="58"
                                Stroke="{DynamicResource Divider}"
                                StrokeThickness="0.5"
                                WidthRequest="58">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Image Aspect="AspectFit" Source="halo2_device_icon.png" />
                            </Border>
                            <Border
                                Margin="78,66,0,0"
                                Padding="5"
                                BackgroundColor="{DynamicResource SurfaceSecondary}"
                                HeightRequest="54"
                                Stroke="{DynamicResource Divider}"
                                StrokeThickness="0.5"
                                WidthRequest="54">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Image Aspect="AspectFit" Source="hi98594_new.png" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout Grid.Column="1" Spacing="9" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                LineBreakMode="WordWrap"
                                Text="Probe, photometer, and meter ready"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="12"
                                LineBreakMode="WordWrap"
                                Text="The home screen now points to one scan flow, then keeps measurement, log review, and reporting separate."
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <Label FontAttributes="Bold" FontSize="11" Text="HALO probes" TextColor="{StaticResource Primary}" />
                                <Label Grid.Column="1" FontAttributes="Bold" FontSize="11" Text="Photometers" TextColor="{StaticResource Primary}" />
                                <Label Grid.Row="1" FontAttributes="Bold" FontSize="11" Text="HI meters" TextColor="{StaticResource Primary}" />
                                <Label Grid.Row="1" Grid.Column="1" FontAttributes="Bold" FontSize="11" Text="Bluetooth" TextColor="{StaticResource Primary}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource SectionLabelStyle}" Text="WORKFLOW" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Style="{StaticResource DashboardCardStyle}" Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label FontAttributes="Bold" FontSize="18" Text="01" TextColor="{StaticResource Primary}" />
                            <Label FontAttributes="Bold" FontSize="12" Text="Connect" TextColor="{DynamicResource OnSurface}" />
                            <Label FontSize="10" LineBreakMode="WordWrap" Text="Scan once for available instruments." TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label FontAttributes="Bold" FontSize="18" Text="02" TextColor="{StaticResource AnalysisAmber}" />
                            <Label FontAttributes="Bold" FontSize="12" Text="Measure + tag" TextColor="{DynamicResource OnSurface}" />
                            <Label FontSize="10" LineBreakMode="WordWrap" Text="Stream readings and annotate context." TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label FontAttributes="Bold" FontSize="18" Text="03" TextColor="{StaticResource Success}" />
                            <Label FontAttributes="Bold" FontSize="12" Text="Store" TextColor="{DynamicResource OnSurface}" />
                            <Label FontSize="10" LineBreakMode="WordWrap" Text="Save logs automatically or manually." TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label FontAttributes="Bold" FontSize="18" Text="04" TextColor="{StaticResource Primary}" />
                            <Label FontAttributes="Bold" FontSize="12" Text="Review" TextColor="{DynamicResource OnSurface}" />
                            <Label FontSize="10" LineBreakMode="WordWrap" Text="Open tables, graphs, PDF, or CSV." TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource SectionLabelStyle}" Text="APP CAPABILITIES" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Style="{StaticResource DashboardCardStyle}">
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="20" Text="&#x25C9;" TextColor="{StaticResource Primary}" />
                            <Label FontAttributes="Bold" FontSize="13" Text="Live stream" TextColor="{DynamicResource OnSurface}" />
                            <Label FontSize="11" LineBreakMode="WordWrap" Text="Continuous readings and monitoring." TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="20" Text="&#x270E;" TextColor="{StaticResource Primary}" />
                            <Label FontAttributes="Bold" FontSize="13" Text="Tag readings" TextColor="{DynamicResource OnSurface}" />
                            <Label FontSize="11" LineBreakMode="WordWrap" Text="Annotate samples, tanks, and notes." TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}">
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="20" Text="&#x2713;" TextColor="{StaticResource Success}" />
                            <Label FontAttributes="Bold" FontSize="13" Text="Auto/manual logs" TextColor="{DynamicResource OnSurface}" />
                            <Label FontSize="11" LineBreakMode="WordWrap" Text="Store records by workflow need." TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="20" Text="&#x21E9;" TextColor="{StaticResource Primary}" />
                            <Label FontAttributes="Bold" FontSize="13" Text="PDF / CSV export" TextColor="{DynamicResource OnSurface}" />
                            <Label FontSize="11" LineBreakMode="WordWrap" Text="Create reports or raw datasets." TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource DashboardCardStyle}">
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="20" Text="&#x2601;" TextColor="{StaticResource Primary}" />
                            <Label FontAttributes="Bold" FontSize="13" Text="Cloud sync" TextColor="{DynamicResource OnSurface}" />
                            <Label FontSize="11" LineBreakMode="WordWrap" Text="Keep instrument data available." TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                        <VerticalStackLayout Spacing="5">
                            <Label FontSize="20" Text="&#x2699;" TextColor="{StaticResource Primary}" />
                            <Label FontAttributes="Bold" FontSize="13" Text="Method control" TextColor="{DynamicResource OnSurface}" />
                            <Label FontSize="11" LineBreakMode="WordWrap" Text="Select and standardize methods." TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource DashboardCardStyle}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label FontSize="22" Text="&#x25A6;" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label FontAttributes="Bold" FontSize="13" Text="Table and graph views" TextColor="{DynamicResource OnSurface}" />
                                <Label FontSize="11" LineBreakMode="WordWrap" Text="Switch between tabular records and visual trends during review." TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
