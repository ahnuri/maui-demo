<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="HannaUIDemo.Features.Home.HomeView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:home="clr-namespace:HannaUIDemo.Features.Home"
    x:DataType="home:HomeViewModel"
    BackgroundColor="{DynamicResource StoreGroupedBackground}">

    <ContentView.Resources>
        <Style x:Key="HeroCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,22" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
            <Setter Property="Stroke" Value="{DynamicResource Divider}" />
            <Setter Property="StrokeThickness" Value="0.5" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="22" />
            </Setter>
        </Style>
        <Style x:Key="FeatureCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,16" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
            <Setter Property="Stroke" Value="{DynamicResource Divider}" />
            <Setter Property="StrokeThickness" Value="0.5" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="16" />
            </Setter>
        </Style>
        <Style x:Key="OutlineCtaStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
            <Setter Property="Stroke" Value="{StaticResource Primary}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="26" />
            </Setter>
        </Style>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
            <Setter Property="Stroke" Value="{DynamicResource Divider}" />
            <Setter Property="StrokeThickness" Value="0.5" />
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="16" />
            </Setter>
        </Style>
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,4,16,28" Spacing="20">

            <!-- Hero -->
            <Border Style="{StaticResource HeroCardStyle}">
                <Border.Shadow>
                    <Shadow Opacity="0.07" Radius="16" Offset="0,4" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Label
                        FontAttributes="Bold"
                        FontSize="28"
                        LineBreakMode="WordWrap"
                        Text="Connect Your Instruments"
                        TextColor="{DynamicResource OnSurface}" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Anywhere. Anytime."
                        TextColor="{StaticResource Primary}" />
                    <Label
                        FontSize="14"
                        LineBreakMode="WordWrap"
                        Text="Monitor water quality with precision. Pair HALO® probes, photometers, and multiparameter meters over Bluetooth® for live readings, graphs, and log sync."
                        TextColor="{DynamicResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

            <!-- Instruments -->
            <Border
                Padding="10,14"
                BackgroundColor="{DynamicResource Surface}"
                Stroke="{DynamicResource Divider}"
                StrokeThickness="0.5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" HeightRequest="108">
                    <Image Aspect="AspectFit" Source="halo2_device_icon.png" />
                    <Image Grid.Column="1" Aspect="AspectFit" Source="photometer_hi97115.png" />
                    <Image Grid.Column="2" Aspect="AspectFit" Source="hi98594_new.png" />
                </Grid>
            </Border>

            <!-- Connection status (tap to scan) -->
            <Border
                Padding="14,13"
                BackgroundColor="{DynamicResource SubtleTeal}"
                Stroke="{StaticResource Primary}"
                StrokeThickness="0.5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ScanDevicesCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label
                        FontSize="24"
                        Text="&#x224B;"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="{Binding ConnectedSummary}"
                            TextColor="{DynamicResource OnSurface}" />
                        <Label
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            Text="Tap to scan and pair instruments via Bluetooth."
                            TextColor="{DynamicResource OnSurfaceVariant}" />
                    </VerticalStackLayout>
                    <Label
                        Grid.Column="2"
                        FontSize="22"
                        Text="&#x203A;"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Get started -->
            <VerticalStackLayout Spacing="10">
                <Label
                    CharacterSpacing="1"
                    FontAttributes="Bold"
                    FontSize="11"
                    Text="GET STARTED"
                    TextColor="{DynamicResource OnSurfaceVariant}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border
                        Padding="12,14"
                        BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Divider}"
                        StrokeThickness="0.5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ScanDevicesCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Border
                                BackgroundColor="{DynamicResource SubtleTeal}"
                                HeightRequest="36"
                                StrokeThickness="0"
                                WidthRequest="36">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    Text="1"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                HorizontalTextAlignment="Center"
                                Text="Scan"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="10"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Text="Find devices"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Padding="12,14"
                        BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Divider}"
                        StrokeThickness="0.5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DemoModeCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Border
                                BackgroundColor="{DynamicResource SubtleTeal}"
                                HeightRequest="36"
                                StrokeThickness="0"
                                WidthRequest="36">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    Text="2"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                HorizontalTextAlignment="Center"
                                Text="Measure"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="10"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Text="Live readings"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Padding="12,14"
                        BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Divider}"
                        StrokeThickness="0.5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewLogsCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Border
                                BackgroundColor="{DynamicResource SubtleTeal}"
                                HeightRequest="36"
                                StrokeThickness="0"
                                WidthRequest="36">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    Text="3"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                HorizontalTextAlignment="Center"
                                Text="Logs"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="10"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Text="History &amp; export"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- Capabilities -->
            <VerticalStackLayout Spacing="10">
                <Label
                    CharacterSpacing="1"
                    FontAttributes="Bold"
                    FontSize="11"
                    Text="CAPABILITIES"
                    TextColor="{DynamicResource OnSurfaceVariant}" />
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource FeatureCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label FontSize="20" Text="&#x2699;" TextColor="{StaticResource Primary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Multi-Device"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="11"
                                LineBreakMode="WordWrap"
                                Text="HALO-2, HI97115, HI98x94"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource FeatureCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label FontSize="20" Text="&#x25C9;" TextColor="{StaticResource Primary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Real-Time"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="11"
                                LineBreakMode="WordWrap"
                                Text="Graphs &amp; workflows"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FeatureCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label FontSize="20" Text="&#x2601;" TextColor="{StaticResource Primary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Cloud Sync"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="11"
                                LineBreakMode="WordWrap"
                                Text="Hanna Cloud export"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FeatureCardStyle}">
                        <VerticalStackLayout Spacing="6">
                            <Label FontSize="20" Text="&#x224B;" TextColor="{StaticResource Primary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Bluetooth"
                                TextColor="{DynamicResource OnSurface}" />
                            <Label
                                FontSize="11"
                                LineBreakMode="WordWrap"
                                Text="Pair &amp; reconnect"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- Stats -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Style="{StaticResource StatCardStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ViewLogsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontSize="12"
                                Text="Today's logs"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="26"
                                Text="{Binding TodayLogsCount}"
                                TextColor="{DynamicResource OnSurface}" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="1"
                            FontSize="20"
                            Text="&#x203A;"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenDevicesCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontSize="12"
                                Text="Connected"
                                TextColor="{DynamicResource OnSurfaceVariant}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="26"
                                Text="{Binding ConnectedDevicesCount}"
                                TextColor="{DynamicResource OnSurface}" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="1"
                            FontSize="20"
                            Text="&#x203A;"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- CTAs -->
            <Button
                BackgroundColor="{StaticResource Primary}"
                Command="{Binding ScanDevicesCommand}"
                CornerRadius="26"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="52"
                Text="&#x224B;  Scan Devices"
                TextColor="White" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Style="{StaticResource OutlineCtaStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DemoModeCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Padding="0,14"
                        Spacing="8">
                        <Label
                            FontSize="17"
                            Text="&#x25A6;"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="Demo Mode"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource OutlineCtaStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ViewLogsCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Padding="0,14"
                        Spacing="8">
                        <Label
                            FontSize="17"
                            Text="&#x2630;"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="View Logs"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Menu hint -->
            <Border
                Padding="14,12"
                BackgroundColor="{DynamicResource SurfaceSecondary}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="10">
                    <Label
                        FontSize="18"
                        Text="&#x2630;"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="13"
                        LineBreakMode="WordWrap"
                        Text="Open the menu for Measure, Log History, Information, Hanna Cloud, and Help."
                        TextColor="{DynamicResource OnSurfaceVariant}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="0">
                <Label
                    FontAttributes="Bold"
                    FontSize="13"
                    Text="Hanna."
                    TextColor="{StaticResource Primary}" />
                <Label
                    FontSize="13"
                    Text=" Instruments for Life.®"
                    TextColor="{DynamicResource OnSurfaceVariant}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
