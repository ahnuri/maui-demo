<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="HannaUIDemo.Features.Instruments.Logs.LogHistoryDeviceLogsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:logs="clr-namespace:HannaUIDemo.Features.Instruments.Logs"
    x:DataType="logs:LogHistoryDeviceLogsViewModel"
    x:Name="RootDeviceLogsView"
    BackgroundColor="{DynamicResource PageBackground}">

    <ContentView.Resources>
        <DataTemplate x:Key="ModelFilterChipTemplate" x:DataType="logs:LogModelFilterChipViewModel">
            <Border HeightRequest="52" Padding="14,10" BackgroundColor="{Binding BackgroundColor}" Stroke="{Binding StrokeColor}" StrokeThickness="{StaticResource StrokeThick}" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource RadiusLg}" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:Reference RootDeviceLogsView}, Path=BindingContext.SelectModelFilterCommand}" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="3" VerticalOptions="Center">
                    <Label FontAttributes="{Binding FontAttributes}" FontSize="{StaticResource FontSizeBodyLarge}" HorizontalTextAlignment="Center" Text="{Binding Label}" TextColor="{Binding TextColor}" />
                    <Label FontSize="{StaticResource FontSizeCaption}" HorizontalTextAlignment="Center" Text="{Binding CountLine}" TextColor="{Binding TextColor}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TankGroupTemplate" x:DataType="logs:LogTankGroupViewModel">
            <Border Margin="0,0,0,8" Padding="{StaticResource SpacingMd}" BackgroundColor="{DynamicResource SurfaceSecondary}" Stroke="{DynamicResource Divider}" StrokeThickness="{StaticResource StrokeThin}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource RadiusMd}" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenTankCommand}" />
                </Border.GestureRecognizers>
                <!-- Layout (per design):
                       Row 0: TankName  sync_icon . . . . . . . . . .
                       Row 1: date → date  . . . . . . . . . . chevron (mid-right)
                       Row 2: file/record summary
                -->
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="{StaticResource SpacingSm}">
                    <HorizontalStackLayout Grid.ColumnSpan="2" Spacing="{StaticResource SpacingSm}" VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="{StaticResource FontSizeSubhead}"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding TankName}"
                            TextColor="{DynamicResource OnSurface}"
                            VerticalOptions="Center" />
                        <Image
                            WidthRequest="{StaticResource IconSizeSm}"
                            HeightRequest="{StaticResource IconSizeSm}"
                            Aspect="AspectFit"
                            SemanticProperties.Description="{Binding CloudUploadAccessibilityHint}"
                            Source="{Binding CloudSyncIconSource}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label
                        Grid.Row="1"
                        FontSize="{StaticResource FontSizeCaption}"
                        Text="{Binding DateRangeSummary}"
                        TextColor="{DynamicResource OnSurfaceVariant}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        FontSize="{StaticResource FontSizeLargeTitle}"
                        IsVisible="{Binding ShowDetailChevron}"
                        Text="&#x203A;"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="{StaticResource SpacingSmPlus}">
                        <Label FontSize="{StaticResource FontSizeCaption}" Text="{Binding FileCountLabel}" TextColor="{DynamicResource OnSurfaceVariant}" />
                        <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeCaption}" Text="{Binding RecordCountLabel}" TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LogEntryTemplate" x:DataType="logs:LogEntryViewModel">
            <Border Margin="0,0,0,8" Padding="{StaticResource SpacingMd}" BackgroundColor="{DynamicResource SurfaceSecondary}" Stroke="{Binding CardStroke}" StrokeThickness="{StaticResource StrokeThick}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource RadiusMd}" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenLogCommand}" />
                </Border.GestureRecognizers>
                <!-- Layout (per design):
                       Row 0: File_name sync_icon . . . . . . . . . .
                       Row 1: date → date  . . . . . . . . . . chevron (mid-right)
                       Row 2: records pill
                -->
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource SpacingSmPlus}" RowSpacing="{StaticResource SpacingXs}">
                    <CheckBox Grid.RowSpan="3" IsChecked="{Binding IsSelected}" IsVisible="{Binding IsEditModeActive}" Color="{StaticResource Primary}" VerticalOptions="Start" />
                    <HorizontalStackLayout Grid.Column="1" Grid.ColumnSpan="2" Spacing="{StaticResource SpacingSm}" VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="{StaticResource FontSizeSubhead}"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding Title}"
                            TextColor="{DynamicResource OnSurface}"
                            VerticalOptions="Center" />
                        <Image
                            WidthRequest="{StaticResource IconSizeSm}"
                            HeightRequest="{StaticResource IconSizeSm}"
                            Aspect="AspectFit"
                            SemanticProperties.Description="{Binding CloudUploadAccessibilityHint}"
                            Source="{Binding CloudSyncIconSource}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Row="1" Grid.Column="1" FontSize="{StaticResource FontSizeCaption}" Text="{Binding DateRangeLabel}" TextColor="{DynamicResource OnSurfaceVariant}" VerticalOptions="Center" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="2"
                        FontSize="{StaticResource FontSizeLargeTitle}"
                        IsVisible="{Binding ShowDetailChevron}"
                        Text="&#x203A;"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />
                    <Border Grid.Row="2" Grid.Column="1" Padding="6,3" BackgroundColor="{Binding RecordCountBackground}" HorizontalOptions="Start" IsVisible="{Binding ShowRecordCount}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource RadiusXs}" />
                        </Border.StrokeShape>
                        <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeCaption}" Text="{Binding RecordCountLabel}" TextColor="{Binding RecordCountColor}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ModelSectionTemplate" x:DataType="logs:LogModelSectionViewModel">
            <Border Margin="0,0,0,14" Padding="{StaticResource SpacingMdPlus}" BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Divider}" StrokeThickness="{StaticResource StrokeThin}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource RadiusXl}" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="{StaticResource SpacingSmPlus}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingMd}" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpacingXs}">
                        <Image
                            Grid.RowSpan="2"
                            HeightRequest="{StaticResource IconSizeXl}"
                            WidthRequest="{StaticResource IconSizeXl}"
                            Source="{Binding DeviceIcon}"
                            Aspect="AspectFit"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="{StaticResource FontSizeSubhead}"
                            LineBreakMode="TailTruncation"
                            Text="{Binding DeviceLabel}"
                            TextColor="{DynamicResource OnSurface}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="2"
                            FontAttributes="Bold"
                            FontSize="{StaticResource FontSizeCaption}"
                            HorizontalTextAlignment="End"
                            LineBreakMode="NoWrap"
                            Text="{Binding SummaryLabel}"
                            TextColor="{Binding Accent}"
                            VerticalOptions="Center" />
                        <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="{StaticResource SpacingSmPlus}">
                            <Label
                                FontSize="{StaticResource FontSizeCaption}"
                                HorizontalTextAlignment="Start"
                                LineBreakMode="TailTruncation"
                                Text="{Binding FirmwareLabel}"
                                TextColor="{DynamicResource OnSurfaceVariant}"
                                VerticalOptions="Center" />
                            <BoxView
                                Grid.Column="1"
                                WidthRequest="1"
                                HeightRequest="14"
                                Color="{DynamicResource Divider}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                FontSize="{StaticResource FontSizeCaption}"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"
                                LineBreakMode="TailTruncation"
                                Text="{Binding BleLabel}"
                                TextColor="{DynamicResource OnSurfaceVariant}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource Divider}" />
                    <VerticalStackLayout BindableLayout.ItemTemplate="{StaticResource TankGroupTemplate}" BindableLayout.ItemsSource="{Binding TankGroups}" IsVisible="{Binding IsPhotometer}" Spacing="0" />
                    <VerticalStackLayout BindableLayout.ItemTemplate="{StaticResource LogEntryTemplate}" BindableLayout.ItemsSource="{Binding LogEntries}" IsVisible="{Binding IsPhotometer, Converter={StaticResource InvertedBoolConverter}}" Spacing="0" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="16,8,16,0" Spacing="{StaticResource SpacingSm}">
            <Label FontSize="{StaticResource FontSizeCaption}" Text="{Binding ModelFilterHint}" TextColor="{DynamicResource OnSurfaceMuted}" />
            <ScrollView HeightRequest="56" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
                <HorizontalStackLayout BindableLayout.ItemTemplate="{StaticResource ModelFilterChipTemplate}" BindableLayout.ItemsSource="{Binding ModelFilters}" Spacing="{StaticResource SpacingSm}" VerticalOptions="Center" />
            </ScrollView>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingSm}" IsVisible="{Binding ShowLogActionRow}">
                <Label
                    FontSize="{StaticResource FontSizeSmall}"
                    IsVisible="{Binding ShowEditModeActions}"
                    Text="{Binding TapToSelectHint}"
                    TextColor="{DynamicResource OnSurfaceVariant}"
                    VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="{StaticResource SpacingLg}" HorizontalOptions="End" VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="{StaticResource FontSizeSmall}"
                        IsVisible="{Binding ShowEditModeActions}"
                        Text="{Binding SelectAllLabel}"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectAllVisibleCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label
                        FontSize="{StaticResource FontSizeSmall}"
                        IsVisible="{Binding ShowClearSelection}"
                        Text="{Binding ClearLabel}"
                        TextColor="{DynamicResource OnSurfaceVariant}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClearSelectionCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label
                        FontAttributes="Bold"
                        FontSize="{StaticResource FontSizeSmall}"
                        Text="{Binding EditModeButtonText}"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleEditModeCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,24" BindableLayout.ItemTemplate="{StaticResource ModelSectionTemplate}" BindableLayout.ItemsSource="{Binding ModelSections}" Spacing="0" />
        </ScrollView>

        <Border Grid.Row="2" Padding="14,10" BackgroundColor="{DynamicResource Surface}" IsVisible="{Binding ShowSelectionBar}" Stroke="{DynamicResource Divider}" StrokeThickness="{StaticResource StrokeThin}">
            <VerticalStackLayout Spacing="{StaticResource SpacingSm}">
                <Label FontAttributes="Bold" FontSize="{StaticResource FontSizeBody}" Text="{Binding SelectionSummary}" TextColor="{DynamicResource OnSurface}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpacingSm}">
                    <Button BackgroundColor="{StaticResource Primary}" Command="{Binding ShareSelectedCommand}" CornerRadius="{StaticResource RadiusMd}" FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" HeightRequest="{StaticResource ButtonHeightSm}" Text="{Binding ShareLabel}" TextColor="White" />
                    <Button Grid.Column="1" BackgroundColor="Transparent" BorderColor="{DynamicResource Divider}" BorderWidth="{StaticResource StrokeThin}" Command="{Binding DeleteSelectedCommand}" CornerRadius="{StaticResource RadiusMd}" FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" HeightRequest="{StaticResource ButtonHeightSm}" Text="{Binding DeleteLabel}" TextColor="{DynamicResource OnSurface}" />
                    <Button Grid.Column="2" BackgroundColor="Transparent" BorderColor="{StaticResource Primary}" BorderWidth="{StaticResource StrokeThick}" Command="{Binding SyncSelectedToCloudCommand}" CornerRadius="{StaticResource RadiusMd}" FontAttributes="Bold" FontSize="{StaticResource FontSizeSmall}" HeightRequest="{StaticResource ButtonHeightSm}" IsEnabled="{Binding IsSyncing, Converter={StaticResource InvertedBoolConverter}}" Text="{Binding SyncLabel}" TextColor="{StaticResource Primary}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
