<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HannaUIDemo.Features.Instruments.Photometer.MeasurePhotometerView"
             BackgroundColor="{DynamicResource AppBackground}">
    <Grid RowDefinitions="*, Auto">
        <ScrollView x:Name="BodyScroll" Grid.Row="0">
            <VerticalStackLayout x:Name="BodyStack" Padding="18,10,18,14" Spacing="0" />
        </ScrollView>
        <VerticalStackLayout x:Name="FooterHost" Grid.Row="1" Padding="18,10,18,20" Spacing="10" IsVisible="False" />
    </Grid>
</ContentView>
